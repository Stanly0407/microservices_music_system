# resource-db
RESOURCE_DB_NAME=resource-db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres

# song-db
SONG_DB_NAME=song-db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres

# storage-db
STORAGE_DB_NAME=storage-db
STORAGE_DB_USER=postgres
STORAGE_DB_PASSWORD=postgres

# resource-service (container-specific values)
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource-db

# song-service (container-specific values)
SONG_DB_URL=jdbc:postgresql://song-db:5432/song-db

# storage-service (container-specific values)
STORAGE_DB_URL=jdbc:postgresql://storage-db:5432/storage-db

# eureka
EUREKA_SERVER_URL=http://eureka-server:8761/eureka

# config server
CONFIG_SERVER_GIT_URI=https://github.com/Stanly0407/microservices-music-system-config.git
CONFIG_SERVER_URL=http://config-server:8888

# S3 / LocalStack
AWS_S3_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
AWS_REGION=us-east-1

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://keycloak:8090/realms/music-system

# resource-service -> storage-service (OAuth2 client_credentials service account)
STORAGE_SERVICE_CLIENT_ID=resource-service-client
STORAGE_SERVICE_CLIENT_SECRET=resource-service-secret
