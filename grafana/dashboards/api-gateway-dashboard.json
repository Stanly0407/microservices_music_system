{
  "title": "API Gateway Performance",
  "uid": "api-gateway-performance",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count[1m])) by (routeId)",
          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 Latency by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(spring_cloud_gateway_requests_seconds_bucket[5m])) by (le, routeId))",
          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate (5xx) by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{httpStatusCode=~\"5..\"}[1m])) by (routeId) / sum(rate(spring_cloud_gateway_requests_seconds_count[1m])) by (routeId)",
          "legendFormat": "{{routeId}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by Status Code",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count[1m])) by (httpStatusCode)",
          "legendFormat": "{{httpStatusCode}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Average Latency by Route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_sum[1m])) by (routeId) / sum(rate(spring_cloud_gateway_requests_seconds_count[1m])) by (routeId)",
          "legendFormat": "{{routeId}}"
        }
      ]
    }
  ]
}
