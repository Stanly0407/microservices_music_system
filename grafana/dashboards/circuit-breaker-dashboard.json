{
  "title": "Storage Circuit Breaker",
  "uid": "storage-circuit-breaker",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Circuit Breaker State (storageService)",
      "description": "1 = active state. Watch it flip CLOSED -> OPEN -> HALF_OPEN -> CLOSED while you stop/start storage-service and hit POST /resources.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "lineInterpolation": "stepAfter", "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"storageService\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Rejected Calls (Circuit Open)",
      "description": "Calls short-circuited without reaching storage-service. Should spike once the breaker opens.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(resilience4j_circuitbreaker_not_permitted_calls_total{name=\"storageService\"}[1m])",
          "legendFormat": "not permitted"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failure Rate",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_failure_rate{name=\"storageService\"}",
          "legendFormat": "failure rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "Calls by Outcome",
      "description": "Successful vs failed calls that actually reached storage-service (excludes rejected calls while breaker is open).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count{name=\"storageService\"}[1m])",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Fallback Events (logs)",
      "description": "Log lines from resource-service where StorageServiceClient fell back to a cached/stub storage location.",
      "type": "logs",
      "datasource": { "type": "elasticsearch", "uid": "Elasticsearch" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "query": "message:\"falling back\" AND service:\"resource-service\"",
          "metrics": [{ "type": "logs", "id": "1" }],
          "timeField": "@timestamp"
        }
      ]
    }
  ]
}
